<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="16dp">

    <!-- topo: etiqueta + on/off -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="EQUALIZER"
            android:textColor="@color/bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/eqOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="EQ ON"
            android:textColor="@color/bg"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- sliders verticais -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="200dp">

                <SeekBar
                    android:id="@+id/eqS0"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="30"
                    android:progressTint="@color/red"
                    android:thumbTint="@color/green"
                    android:backgroundTint="@color/line" />
            </FrameLayout>

            <TextView
                android:id="@+id/eqL0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0 dB"
                android:textColor="@color/silver"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="200dp">

                <SeekBar
                    android:id="@+id/eqS1"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="30"
                    android:progressTint="@color/red"
                    android:thumbTint="@color/green"
                    android:backgroundTint="@color/line" />
            </FrameLayout>

            <TextView
                android:id="@+id/eqL1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0 dB"
                android:textColor="@color/silver"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="230"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="200dp">

                <SeekBar
                    android:id="@+id/eqS2"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="30"
                    android:progressTint="@color/red"
                    android:thumbTint="@color/green"
                    android:backgroundTint="@color/line" />
            </FrameLayout>

            <TextView
                android:id="@+id/eqL2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0 dB"
                android:textColor="@color/silver"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="950"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="200dp">

                <SeekBar
                    android:id="@+id/eqS3"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="30"
                    android:progressTint="@color/red"
                    android:thumbTint="@color/green"
                    android:backgroundTint="@color/line" />
            </FrameLayout>

            <TextView
                android:id="@+id/eqL3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0 dB"
                android:textColor="@color/silver"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.6k"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="200dp">

                <SeekBar
                    android:id="@+id/eqS4"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="30"
                    android:progressTint="@color/red"
                    android:thumbTint="@color/green"
                    android:backgroundTint="@color/line" />
            </FrameLayout>

            <TextView
                android:id="@+id/eqL4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0 dB"
                android:textColor="@color/silver"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14k"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center">

        <TextView
            android:id="@+id/eqP0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_off"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Plano"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/eqP1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/tab_off"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Baixo"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/eqP2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/tab_off"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Rock"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/eqP3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/tab_off"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Pop"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/eqP4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/tab_off"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Voz"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="// aplica no audio instantaneo"
        android:textColor="@color/muted"
        android:textSize="9sp"
        android:fontFamily="monospace" />
</LinearLayout>
